# ─── Backend (Express.js) — copy to backend/.env ─────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Random server-only value used to protect OAuth callbacks. In production,
# set this in Railway. Never expose it to the frontend.
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

# ── Supabase ──────────────────────────────────────────────────────────────────
# Same project URL as frontend
SUPABASE_URL=https://your-project.supabase.co

# Service role key — NEVER expose this in the browser
# Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ── Frontend URL (for CORS & OAuth redirects) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stability AI (optional — for image generation) ────────────────────────────
STABILITY_API_KEY=sk-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@bmapzai.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# ── Meta (Facebook / Instagram) ───────────────────────────────────────────────
META_APP_ID=...
META_APP_SECRET=...
META_REDIRECT_URI=http://localhost:3001/api/oauth/meta/callback
# Optional override when Meta retires the current Graph API version.
META_GRAPH_VERSION=v24.0

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/oauth/linkedin/callback
# LinkedIn Marketing API version in YYYYMM format.
LINKEDIN_API_VERSION=202606

# Optional extra HTTPS hosts whose images may be imported into Canva.
# Bmapz Supabase Storage is allowed automatically.
CANVA_IMPORT_ALLOWED_HOSTS=

# ── Twitter / X ───────────────────────────────────────────────────────────────
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_REDIRECT_URI=http://localhost:3001/api/oauth/twitter/callback

# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REDIRECT_URI=http://localhost:3001/api/oauth/tiktok/callback
