# ─── Frontend (Vite) — copy to .env.local at project root ────────────────────
# Supabase project URL (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Backend API base URL (no trailing slash)
# Local dev: http://localhost:3001
# Production: https://bmapz-production.up.railway.app
VITE_API_URL=http://localhost:3001
# Updated: trigger rebuild with correct VITE_API_URL secret
